# Gestor de paquetes: pnpm (ver AGENTS.md).
#
# Este proyecto NO tiene dependencias de Node: los contratos usan Foundry y el motor de
# riesgo es JavaScript puro con modulos nativos de Node. Por eso pnpm no instala nada y no
# hay scripts de instalacion que autorizar: la superficie de ataque de cadena de suministro
# es cero.
#
# El archivo se mantiene para que, si mas adelante se agrega un frontend, la politica ya
# quede establecida: pnpm NO ejecuta scripts por defecto y las excepciones se autorizan de
# forma explicita en package.json -> pnpm.onlyBuiltDependencies.

auto-install-peers=true
strict-peer-dependencies=false
