{
  "name": "riskguard-avax",
  "version": "0.2.0",
  "private": true,
  "description": "RiskGuard - agent + MetaMask Agent Wallet plugin: policy-gated DeFi on Monad Testnet",
  "scripts": {
    "build": "pnpm --dir web install && pnpm --dir web build",
    "build:contracts": "forge build",
    "test": "forge test -vv",
    "fmt": "forge fmt",
    "deploy:monad": "forge script script/DeployMonad.s.sol --rpc-url monad_testnet --broadcast",
    "deploy:monad:verify": "forge script script/DeployMonad.s.sol --rpc-url monad_testnet --broadcast --verify",
    "plugin:install": "pnpm --dir plugin install",
    "plugin:build": "pnpm --dir plugin build",
    "plugin:type-check": "pnpm --dir plugin type-check",
    "plugin:test": "pnpm --dir plugin test",
    "deploy:fuji": "forge script script/Deploy.s.sol --rpc-url avax_fuji --broadcast",
    "deploy:fuji:verify": "forge script script/Deploy.s.sol --rpc-url avax_fuji --broadcast --verify",
    "deploy:mainnet": "forge script script/Deploy.s.sol --rpc-url avax_mainnet --broadcast --verify",
    "seed:fuji": "node scripts/seed-fuji.js",
    "export:web": "node scripts/export-web-data.js",
    "stereum:proxy": "node --env-file=.env server/stereum-proxy.mjs",
    "test:engine": "node scripts/test-engine.js",
    "test:e2e": "node scripts/e2e-anvil.js",
    "ascii": "node scripts/ascii-lint.js",
    "serve:web": "node scripts/serve-web.js",
    "check": "node scripts/ascii-lint.js && node scripts/test-engine.js",
    "score": "node scripts/score-cli.js",
    "dataset:build": "node scripts/build-dataset.js",
    "collect:onchain": "node scripts/collect-onchain.js",
    "backtest": "node scripts/backtest.js",
    "backtest:real": "node scripts/backtest.js --dataset data/dataset-avalanche.json --threshold 55 --sweep",
    "backtest:onchain": "node scripts/backtest.js --dataset data/dataset-avalanche-onchain.json --threshold 55 --sweep"
  },
  "dependencies": {}
}
