# Copiar a .env y completar
# Clave privada de la cuenta de despliegue (NUNCA subirla al repositorio)
PRIVATE_KEY=

# RPC de Avalanche
AVAX_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
AVAX_MAINNET_RPC=https://api.avax.network/ext/bc/C/rpc

# Resultado del despliegue
REGISTRY_ADDRESS=
LOG_ADDRESS=
RISKGUARD_ADDRESS=

# API de Snowtrace (opcional, para verificar contratos)
SNOWTRACE_API_KEY=

# API de DefiLlama (no requiere clave)
DEFILLAMA_BASE=https://api.llama.fi
