# Copiar a .env y completar
# Clave privada de la cuenta de despliegue (NUNCA subirla al repositorio)
PRIVATE_KEY=

# Direccion que recibe 1000 mUSD en el despliegue de Monad para operar la demo.
# Debe coincidir con la billetera activa del Agent Wallet (mm wallet list).
AGENT_ADDRESS=

# Alternativa: semilla BIP39 de la que se deriva PRIVATE_KEY (index 0).
# Si la usas, deriva la clave y NUNCA publiques la semilla.
# MNEMONIC="..."
# Direccion publica de la cuenta (solo para referencia/faucet)
ADDRESS=

# Red objetivo del despliegue de prueba
TARGET_NETWORK=monad

# RPC de Monad Testnet y de Avalanche (legacy)
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
AVAX_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
AVAX_MAINNET_RPC=https://api.avax.network/ext/bc/C/rpc

# Resultado del despliegue de Monad (DeployMonad imprime estas mismas variables).
# Son las que lee el plugin mm-plugin-riskguard.
RISKGUARD_GUARD_ADDRESS=
RISKGUARD_REGISTRY_ADDRESS=
RISKGUARD_AGENTLOG_ADDRESS=
RISKGUARD_TOKEN_ADDRESS=
RISKGUARD_VAULT_ADDRESS=
RISKGUARD_CHAIN_ID=10143
RISKGUARD_RPC_URL=https://testnet-rpc.monad.xyz

# API de Monadscan (opcional, para verificar contratos)
MONADSCAN_API_KEY=

# API de DefiLlama (no requiere clave)
DEFILLAMA_BASE=https://api.llama.fi

# Stereum (pagos Bolivia con stablecoin). SOLO server-side: nunca en VITE_*.
# Obtener en https://console.stereum.tech
STEREUM_API_KEY=
STEREUM_SECRET_KEY=
STEREUM_BASE=https://api.stereum.tech
STEREUM_PROXY_PORT=8788
