# RiskGuard environment file.
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# .env is gitignored. NEVER commit or share it: it may contain a private key.

# ---------------------------------------------------------------------------
# Deploy credentials (only needed to deploy the contracts on Monad Testnet)
# ---------------------------------------------------------------------------

# Private key of the deploy account. Generate a dedicated one with:
#   cast wallet new
# Copy the "Private key" it prints, and fund the "Address" it prints with
# testnet MON (gas) from https://faucet.monad.xyz/
PRIVATE_KEY=

# Optional BIP39 seed phrase. If set, PRIVATE_KEY is derived from it (index 0).
# Prefer a throwaway phrase; NEVER publish it.
# MNEMONIC=""

# Public address of the deploy account (optional; for reference / faucet).
ADDRESS=

# ---------------------------------------------------------------------------
# Agent Wallet (the wallet the plugin signs from)
# ---------------------------------------------------------------------------

# Address that receives 1000 mUSD on deploy and acts as the plugin's wallet.
# Get it with:
#   mm init --wallet server-wallet --mode guard
#   mm wallet address
# It must be the wallet you run `mm` with, and it needs testnet MON for gas.
AGENT_ADDRESS=

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

TARGET_NETWORK=monad
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# Legacy (Avalanche build); not used by the Monad flow.
AVAX_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
AVAX_MAINNET_RPC=https://api.avax.network/ext/bc/C/rpc

# ---------------------------------------------------------------------------
# RiskGuard contracts (printed by: pnpm run deploy:monad)
# Paste the export lines the deploy script prints.
# ---------------------------------------------------------------------------

RISKGUARD_GUARD_ADDRESS=
RISKGUARD_REGISTRY_ADDRESS=
RISKGUARD_AGENTLOG_ADDRESS=
RISKGUARD_TOKEN_ADDRESS=
# Default (safe) vault; optional first argument for the mm commands.
RISKGUARD_VAULT_ADDRESS=
RISKGUARD_CHAIN_ID=10143
# Read-only RPC for the plugin. The Agent Wallet proxy does not relay chain
# 10143, so reads go straight to this endpoint (writes still use the wallet).
RISKGUARD_RPC_URL=https://testnet-rpc.monad.xyz

# ---------------------------------------------------------------------------
# Optional services
# ---------------------------------------------------------------------------

# Monad explorer API key, only for `--verify`:
#   create one at https://testnet.monadexplorer.com/
MONADSCAN_API_KEY=

# DefiLlama API (no key required).
DEFILLAMA_BASE=https://api.llama.fi

# Stereum (stablecoin payouts, server-side only; never expose in VITE_*).
# Get keys at https://console.stereum.tech
STEREUM_API_KEY=
STEREUM_SECRET_KEY=
STEREUM_BASE=https://api.stereum.tech
STEREUM_PROXY_PORT=8788
