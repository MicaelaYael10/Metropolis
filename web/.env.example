# Copiar a .env solo si quieres apuntar a otros despliegues.
# La app por defecto usa Monad Testnet (10143) con las direcciones ya compiladas
# en web/src/config.ts, asi que no hace falta definir nada para la demo.

# Monad Testnet (10143). Opcional: sobrescribe las direcciones por defecto.
VITE_RISKGUARD_MONAD=0x5bAFa861aa55657b5610Ce0654A130Bf92017732
VITE_REGISTRY_MONAD=0x0B29f202E5beBb4B4F88DD7e489759E31519a93c
VITE_AGENTLOG_MONAD=0xFCdd648D12B840e3C2CF58750Ac8438fac476f9f

# Avalanche C-Chain mainnet (43114). Opcional.
VITE_RISKGUARD_MAINNET=0x0000000000000000000000000000000000000000
VITE_REGISTRY_MAINNET=0x0000000000000000000000000000000000000000
VITE_AGENTLOG_MAINNET=0x0000000000000000000000000000000000000000

# Proxy server-side de Stereum (nunca poner credenciales aca).
VITE_STEREUM_API=http://localhost:8788
